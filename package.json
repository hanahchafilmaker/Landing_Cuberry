{
  "name": "cuberry-landing",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --experimental-sqlite server/index.mjs",
    "dev:landing": "vite --config landing/vite.config.ts",
    "dev:admin": "vite --config admin-v2/vite.config.ts",
    "build": "vite build --config landing/vite.config.ts && vite build --config admin-v2/vite.config.ts",
    "build:landing": "vite build --config landing/vite.config.ts",
    "build:admin": "vite build --config admin-v2/vite.config.ts",
    "typecheck": "tsc -p landing/tsconfig.json && tsc -p admin-v2/tsconfig.json",
    "test": "node test/client-origin.mjs && node test/static-paths.mjs && node test/server-wiring.mjs",
    "test:origin": "node test/client-origin.mjs",
    "test:paths": "node test/static-paths.mjs",
    "test:server": "node test/server-wiring.mjs",
    "test:dom": "node test/dom-flow.mjs",
    "test:cms": "node test/landing-cms.mjs",
    "test:admin": "node test/admin-v2-flow.mjs",
    "sync:seed": "node test/../scripts/sync-seed.mjs"
  },
  "devDependencies": {
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "4.1.17",
    "@tanstack/react-query": "^5.104.0",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "jsdom": "^30.1.1",
    "lucide-react": "^0.453.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.1.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "wouter": "^3.11.0"
  },
  "engines": {
    "node": ">=22.5.0 <23"
  }
}
